    "version": "0.2.0",
    "configurations": [
        {
            "name": "Depurar laboratorio (main)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/EDA/laboratorio/main",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/EDA/laboratorio",
            "environment": [],
